APP_NAME="PPDB Online"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ppdb.sekolah.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppdb
DB_USERNAME=ppdb
DB_PASSWORD=

# Sessions: keep the cookie HTTP-only, same-site and HTTPS-only in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ppdb@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Applicant uploads and generated PDFs. Must not be web accessible.
PPDB_STORAGE_DISK=private

# Where the "public" and "private" disks actually store their files. Leave both
# unset on an ordinary server: files then live under storage/app as usual.
#
# On a serverless host such as Vercel the filesystem is read-only and nothing
# written during a request survives it, so both disks are pointed at Vercel Blob
# instead. Set the driver to "vercel_blob" and supply the read-write token of a
# store created with the matching access level. The two stores are separate
# because a store's public/private access is fixed when it is created, and
# applicant documents must never be reachable by URL alone.
# PUBLIC_DISK_DRIVER=vercel_blob
# PRIVATE_DISK_DRIVER=vercel_blob
# BLOB_PUBLIC_RW_TOKEN=
# BLOB_PRIVATE_RW_TOKEN=

# Ceiling for any single upload, in KB. Keep it under the host's request body
# limit; a Vercel function refuses anything above 4.5 MB before PHP runs.
# PPDB_UPLOAD_MAX_KB=4096

# Proxies whose X-Forwarded-* headers may be believed: a comma separated list,
# or "*" when the app is only reachable through a platform edge that always
# rewrites them, as on Vercel. Leave it unset on a server clients can reach
# directly, where the header is attacker-controlled and trusting it would let
# anyone forge their address past the rate limiters.
# TRUSTED_PROXIES=*

# Rate limits, written as "attempts,minutes".
PPDB_RATE_LIMIT_STATUS=5,1
PPDB_RATE_LIMIT_ADMIN_LOGIN=5,1

# Credentials created by AdminUserSeeder. Set these before the first seed and
# change the password after the first login.
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@sekolah.sch.id
SEED_SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
